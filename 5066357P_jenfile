pipeline {

    agent {

        node {

            label 'master'

        }

    }



    options {

        buildDiscarder logRotator(

                    daysToKeepStr: '15',

                    numToKeepStr: '10'

            )

    }



    environment {

        APP_NAME = "INNO_WATER_TECH_APP"
	PIPELINE_NAME = "5066357P_op_pipe"

	// UAT image and container
	UAT_IMAGE_NAME = "uatsvr_image"
	UAT_CONTAINER = "5066357P_uatsvr"

	// Prod image and container
	PROD_IMAGE_NAME = "prodsvr_image"
	PROD_CONTAINER = "5066357P_prodsvr"


    }


    stages {

        stage('5066357P-opr-s1') {

            steps {

                sh '''
		# remove backup, if any
                  if docker images | grep -q ${UAT_IMAGE_NAME}; then
	             docker rmi -f ${UAT_IMAGE_NAME}
		  fi
		
		# create a backup image
		docker commit ${UAT_CONTAINER} ${UAT_IMAGE_NAME}

		
		#!/bin/bash
		puppet resource file /tmp/5066357P ensure=directory
		puppet resource file /tmp/5066357P/research ensure=absent force=true;
		puppet resource file /tmp/5066357P/research ensure=directory;
		cd /tmp/5066357P/research;
		git clone https://github.com/nchinling/5066357P_op_repo;
		targets=5066357P-uatsvr.localdomain;
		locate_script="/tmp/5066357P/research/5066357P_op_repo/5066357P_script";
		bolt script run $locate_script -t $targets -u clientadm -p user123 --no-host-key-check --run-as root;

		# completion statement
                echo "5066357P_OP_S1: uat web server is backup and updated"

                '''
            }
        }



        stage('5066357P-opr-s2') {

            steps {

                sh '''
		
		curl -Is http://5066357P-uatsvr.localdomain | head -n 1 > /tmp/uatsvr-result-file
		
		if grep -q "HTTP/1.1 200 OK" /tmp/uatsvr-result-file; then
			echo "5066357P_OP_S2: uat svr is running"

		else
			echo "5066357P_OP_S2: uat svr fails"

		fi

                '''

            }

        }



        stage('5066357P-opr-s3') {

            steps {

		echo "5066357P_OP_S3: Proceed stress test uat web server?"
		script {
                    def userInput = input(
			message: 'Proceed with stress test on UAT web server?',
                        parameters: [
                            choice(
                                name: '', 
                                choices: ['Proceed with stress test on uat web server', 'Abort']
                            )
                        ]
                    )
		}	


            }

        }



        stage('5066357P-opr-s4') {

		steps{

		     echo '5066357P_OP_S4: Stress test result is good'
		
		}
            
        }



        stage('5066357P-opr-s5') {

            steps {

              echo "5066357P_OP_S5: Deploy new update to prod web server?"
                script {
                    def userInput = input(
                        message: 'Proceed to update prod web server?',
                        parameters: [
                            choice(
                                name: '',
                                choices: ['Proceed to update prod web server', 'Abort']
                            )
                        ]
                    )
                }


             }

        }


	    stage('5066357P-opr-s6') {

            steps {

                sh '''
                # remove backup, if any
                  if docker images | grep -q ${PROD_IMAGE_NAME}; then
                     docker rmi -f ${PROD_IMAGE_NAME}
                  fi

                # create a backup image
                docker commit ${PROD_CONTAINER} ${PROD_IMAGE_NAME}

                #!/bin/bash
                puppet resource file /tmp/5066357P ensure=directory
                puppet resource file /tmp/5066357P/research ensure=absent force=true;
                puppet resource file /tmp/5066357P/research ensure=directory;
                cd /tmp/5066357P/research;
                git clone https://github.com/nchinling/5066357P_op_repo;
                targets=5066357P-prodsvr.localdomain;
                locate_script="/tmp/5066357P/research/5066357P_op_repo/5066357P_script";
                bolt script run $locate_script -t $targets -u clientadm -p user123 --no-host-key-check --run-as root;

                # completion statement
                echo "5066357P_OP_S6: prod web server is backup and updated"
		
		'''

            }

        }



	    stage('5066357P-opr-s7') {

            steps {

                sh 'echo "Stage 7 completed."'

            }

        }





    }

}




